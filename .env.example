# Toobit API Configuration
TOOBIT_API_KEY=your_toobit_api_key_here
TOOBIT_API_SECRET=your_toobit_api_secret_here
TOOBIT_BASE_URL=https://api.toobit.com
TOOBIT_WS_URL=wss://ws.toobit.com

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here

# Database
DATABASE_URL=sqlite:///./data/wall.db
DATABASE_ECHO=False

# FastAPI Configuration
API_TITLE=WALL Trading Terminal
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# WebSocket Configuration
WS_RECONNECT_INTERVAL=5
WS_RECONNECT_MAX_ATTEMPTS=10
WS_TIMEOUT=30
WS_HEARTBEAT_INTERVAL=30

# Signal Generation Configuration
MIN_SIGNAL_CONFIDENCE=0.6
MAX_SIGNALS_PER_HOUR=5
SIGNAL_CHECK_INTERVAL=60
LATE_ENTRY_MULTIPLIER=1.0

# Entry Watcher Configuration
ENTRY_CHECK_INTERVAL=5
ENTRY_ALERT_TIMEOUT=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/wall.log

# Frontend URL (for Mini App)
FRONTEND_URL=http://localhost:5173
MINI_APP_URL=https://your-domain.com/app
